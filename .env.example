# ============================================
# زبان‌یار | Environment variables
# ============================================

# ---- Supabase (required) ----
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key   # server only, never expose

# ---- AI provider (optional) ----
# Leave empty to run on the built-in deterministic local engine.
# Any OpenAI-compatible endpoint works.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_BASE_URL=https://api.openai.com/v1

# ---- Speech-to-text for pronunciation practice (optional) ----
# Used by /api/pronunciation/attempt. Any provider exposing an
# OpenAI-compatible POST /audio/transcriptions endpoint works
# (OpenAI Whisper, Groq whisper-large-v3, self-hosted faster-whisper...).
#
# If SPEECH_API_KEY is unset the app falls back to OPENAI_API_KEY.
# If neither is set the feature still works: the browser's on-device
# Web Speech API supplies the transcript and the local phonetic engine
# scores it. Responses then carry used_fallback: true.
SPEECH_API_KEY=
SPEECH_MODEL=whisper-1
SPEECH_BASE_URL=https://api.openai.com/v1
